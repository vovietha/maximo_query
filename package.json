{
  "name": "maximo_query",
  "version": "1.0.1",
  "description": "Maximo SQL-like Query Engine via OSLC",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.maximo.sqlconsole",
    "productName": "Maximo SQL Query Console",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "asar": true,
    "files": [
      "server.js",
      "main.js",
      "src/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
  ]
  }
}