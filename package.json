{
  "name": "maximo_query",
  "version": "1.1.1",
  "description": "Maximo SQL-like Query Engine via OSLC",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
  "appId": "com.maximo.sqlconsole",
  "productName": "Maximo SQL Query Console",
  "directories": {
    "output": "dist"
  },
  "publish": {
    "provider": "github",
    "owner": "vovietha",
    "repo": "maximo_query",
    "releaseType": "release"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "differentialPackage": true
  }
}
}
