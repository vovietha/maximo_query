{
  "name": "maximo_query",
  "version": "1.1.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/vovietha/maximo_query.git"
  },
  "description": "Maximo SQL-like Query Engine via OSLC",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
"build": {
  "appId": "com.maximo.sqlconsole",
  "productName": "Maximo SQL Query Console",
  "publish": [
    {
      "provider": "github",
      "owner": "vovietha",
      "repo": "maximo_query"
    }
  ],
  "win": {
    "target": "nsis"
